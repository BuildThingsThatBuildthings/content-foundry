{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contentfoundry.dev/schemas/run.schema.json",
  "title": "Content Foundry run state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job", "status", "current_stage", "stages", "costs", "deployments", "scheduling"],
  "properties": {
    "schema_version": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "job": {"type": "string"},
    "status": {"enum": ["active", "blocked", "complete"]},
    "current_stage": {"type": "string"},
    "stages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "artifacts", "receipts", "attempts"],
        "additionalProperties": true
      }
    },
    "costs": {"type": "object"},
    "deployments": {"type": "array"},
    "scheduling": {"type": "array"}
  }
}
